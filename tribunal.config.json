{
  "sessionsDir": "./sessions",
  "defaultAgents": [
    "claude-sim",
    "codex-sim",
    "local-sim"
  ],
  "agents": {
    "claude-sim": {
      "type": "mock",
      "stance": "cauteloso"
    },
    "codex-sim": {
      "type": "mock",
      "stance": "pragmatico"
    },
    "local-sim": {
      "type": "mock",
      "stance": "critico"
    },
    "claude": {
      "type": "claude",
      "command": "claude",
      "timeoutMs": 90000,
      "model": "claude-opus-5-5"
    },
    "codex": {
      "type": "codex",
      "command": "codex",
      "timeoutMs": 90000
    },
    "claude1": {
      "type": "claude",
      "model": "claude-fable-5-2"
    },
    "claude2": {
      "type": "claude",
      "model": "claude-opus-5-5"
    },
    "agy": {
      "type": "agy",
      "command": "agy",
      "timeoutMs": 90000
    },
    "ollama-local": {
      "type": "ollama",
      "baseUrl": "http://localhost:11434",
      "model": "qwen2.5-coder:7b",
      "timeoutMs": 120000
    }
  }
}
