{
  "name": "agent-tribunal",
  "version": "0.1.0",
  "description": "Tribunal modular de agentes IA (CLIs, modelos locales y MCP) con sesiones persistentes y cuestionamiento humano.",
  "main": "src/index.js",
  "type": "module",
  "bin": {
    "agent-tribunal": "src/index.js",
    "agent-tribunal-mcp": "src/mcp/server.js",
    "agent-tribunal-ui": "src/api/server.js"
  },
  "files": [
    "src/",
    "assets/",
    "tribunal.config.default.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "start": "node src/index.js",
    "server": "node src/api/server.js",
    "mcp": "node src/mcp/server.js",
    "test": "node --test"
  },
  "keywords": [
    "ai",
    "agents",
    "mcp",
    "multi-agent",
    "ollama",
    "claude",
    "codex"
  ],
  "author": "Robert",
  "license": "MIT",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0",
  "dependencies": {
    "express": "^5.3.0"
  }
}
